project_id  = "your-gcp-project-id"
region      = "us-central1"
environment = "lab"

# CIDRs — all within 10.0.0.0/20, right-sized for a ~10-node security test lab
nodes_cidr    = "10.0.0.0/24"
pods_cidr     = "10.1.0.0/21"
services_cidr = "10.2.0.0/24"
master_cidr   = "10.3.0.0/28"

flow_log_sampling = 0.5

k8s_namespace = "security-tools"

# Optional: add APIs beyond the required set
# extra_apis = ["secretmanager.googleapis.com"]
